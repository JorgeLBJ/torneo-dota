# Copia este archivo como .env junto a compose.yml y protégelo: chmod 600 .env
PORT=3000
DATABASE_PATH=/data/torneos.db
COOKIE_SECURE=1
TRUST_PROXY=1
STREAM_PARENT_HOSTS=torneo-dota.jpsolutions.app,sites.google.com
# Vacío: se genera un código aleatorio en cada arranque y se imprime en los registros (docker compose logs torneo-dota)
ADMIN_SETUP_TOKEN=
# Opcional: si se define y aún no hay administradores, crea el usuario "admin" con esta contraseña
ADMIN_PASSWORD=
TZ=UTC
