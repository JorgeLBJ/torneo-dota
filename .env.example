# Variables para desarrollo local. Copia este archivo a ".env" (ya está en .gitignore):
#   cp .env.example .env
# "npm run dev", "npm run seed:oct2026" y "npm run render:og" lo leen solos.
# "npm start" y Docker NO lo usan: en producción las variables van en deploy/.env.

# Puerto HTTP.
PORT=3000

# Archivo SQLite (su carpeta se crea si no existe).
DATABASE_PATH=./data/torneos.db

# Opcional. Crea el administrador "admin" al arrancar si todavía no hay ninguno.
# Sin ella, el primer administrador se crea en http://localhost:3000/admin/setup
ADMIN_PASSWORD=

# Imágenes personalizadas de los equipos.
# Todo vacío: se guardan en ./data/uploads y las sirve la propia app en /uploads.
# Para probar Cloudflare R2, completa LAS CINCO variables (si falta alguna, el servidor no arranca).
# Guía para crear el bucket y el token: deploy/README.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
